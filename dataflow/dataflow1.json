{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_inventory",
						"type": "DatasetReference"
					},
					"name": "inventory"
				},
				{
					"dataset": {
						"referenceName": "ds_item",
						"type": "DatasetReference"
					},
					"name": "item"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_output_adls",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "ls_copy_data",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "join1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as string,",
				"          item_name as string,",
				"          quantity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> inventory",
				"source(output(",
				"          id as string,",
				"          item_name as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> item",
				"inventory, item join(inventory@item_name == item@item_name,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['joined_data_output.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          id = inventory@id,",
				"          item_name = inventory@item_name,",
				"          quantity,",
				"          id = item@id,",
				"          item_name = item@item_name",
				"     )) ~> sink1"
			]
		}
	}
}